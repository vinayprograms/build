# Test: Edge case - Shell variables in commands
# Expected: Should pass $VAR to shell
# Category: Edge Cases
# Description: Tests shell variable syntax vs build variable syntax

build_var = from_needfile

@test:
    # Build variable
    echo "Build var: {build_var}"
    # Shell variable - passed through
    SHELL_VAR="from_shell"
    echo "Shell var: $SHELL_VAR"
    # Shell special variables
    echo "PID: $$"
    echo "Exit: $?"
    # Block mode for proper shell variable handling
    block:
        MY_VAR="hello"
        echo "My var: $MY_VAR"
        for i in 1 2 3; do
            echo "Loop: $i"
        done
