# Test: Full example from spec
# Expected: Should parse the complete example from BUILDFILE_SPEC.md
# Category: Integration
# Description: Tests the complete example from specification

# ====================
# Environments
# ====================

.environment:
    .requires: gcc@latest

.environment: ci
    .using: docker
    .source: ./docker/ci.Dockerfile
    .args: --platform linux/amd64

# ====================
# Global Configuration
# ====================

.shell: bash
.parallel: 8
.default: @all

# ====================
# Variables
# ====================

cc = gcc
cflags = -Wall -Wextra -O2
ldflags =

src_dir = src
build_dir = build

ifdef DEBUG
    cflags = -Wall -Wextra -g -O0 -DDEBUG
end

if {os} == linux
    ldflags = -lpthread
elif {os} == darwin
    ldflags = -framework CoreFoundation
end

# ====================
# Phony Targets
# ====================

@all: {build_dir}/app

@clean:
    rm -rf {build_dir}

@test: {build_dir}/app
    ./{build_dir}/app --run-tests

# ====================
# Build Targets
# ====================

{build_dir}/:
    mkdir -p {target}

{build_dir}/{name}.o: {src_dir}/{name}.c
    .after: {build_dir}/
    block:
        echo "Compiling {name}.c..."
        {cc} {cflags:raw} -c {in} -o {out}

{build_dir}/app: {build_dir}/main.o {build_dir}/utils.o
    .after: {build_dir}/
    block:
        echo "Linking..."
        {cc} {ldflags:raw} -o {target} {deps}
        echo "Build complete: {target}"
