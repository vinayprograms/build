# Test: Pattern target with single capture
# Expected: Should match and expand pattern
# Category: Targets
# Description: Tests basic pattern target with {name} capture
#
# EXAMPLE: `build -f 043_target_pattern_single.build build/main.o` will use
# this pattern matching specification to create `main.c` and then compile
# it.

build/{name}.o: src/{name}.c
    mkdir -p build
    echo "Compiling {name}.c to {name}.o"
    echo "compiled" > {out}

src/{name}.c:
    mkdir -p src
    echo "int {name}() {{ return 0; }}" > {target}
