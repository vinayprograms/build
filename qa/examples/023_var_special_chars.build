# Test: Variable with special characters in value
# Expected: Should handle special chars correctly
# Category: Variables
# Description: Tests variables with paths containing colons, spaces, etc.

path_with_colon = /usr/bin:/usr/local/bin
path_with_spaces = /path/to/my files
flags_with_equals = --config=value

@test:
    echo "Path: {path_with_colon}"
    echo "Spaced: {path_with_spaces}"
    echo "Flags: {flags_with_equals}"
